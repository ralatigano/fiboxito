TELEGRAM_TOKEN=TU_TELEGRAMBOT_TOKEN
OLLAMA_URL=http://localhost:11434/api/generate
MODEL=llama3.2:3b
WISPRO_URL=https://TUISP.wispro.co
WISPRO_TOKEN=TU_WISPRO_TOKEN
WHITELIST_FILE=whitelist.json
LOGS_DIR=logs
MEMORIA_TURNOS=5

# Poller de comprobantes (Wispro help_desk)
WISPRO_COMPROBANTE_CATEGORY_ID=4420e824-c06f-4c8a-9aed-0806d6a3e5b5
OPA_POLL_INTERVAL=120

# OPA Suite / Hola Suite (solo lectura, para consultas manuales)
OPA_BASE_URL=https://TU_DOMINIO.holasuite.com
OPA_TOKEN=TU_TOKEN_OPA

# Telegram: uno o más chat_id que reciben alertas de comprobantes (separados por coma)
# Ejemplo con grupo: TELEGRAM_ADMIN_CHAT_ID=123456789,-987654321001
TELEGRAM_ADMIN_CHAT_ID=TU_CHAT_ID

# NAS OpenMediaVault (acceso SFTP por ZeroTier, autenticación por clave)
NAS_SSH_HOST=10.147.20.XXX          # IP ZeroTier del NAS
NAS_SSH_PORT=22
NAS_SSH_USER=fiboxito               # usuario dedicado y restringido en OMV
NAS_SSH_KEY=keys/fiboxito_nas       # ruta a la clave privada (NO versionar)
NAS_BASE_PATH=.                     # carpeta base (con chroot en OMV = home)
NAS_MAX_FILE_MB=50
NAS_COMPROBANTES_XLSX=Fibox/Comprobantes/Comprobantes.xlsx  # Excel de comprobantes (rel. a NAS_BASE_PATH)
TZ_OFFSET_HORAS=-3                  # offset horario para la columna "Registrado"